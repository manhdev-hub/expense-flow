# ==========================================
# ExpenseFlow Monorepo Environment Template
# ==========================================

# API Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database (Local Docker Compose PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_flow_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_flow_test?schema=public"

# Frontend Web
NEXT_PUBLIC_API_URL=http://localhost:4000

